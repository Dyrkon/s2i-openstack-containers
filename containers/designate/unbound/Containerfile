# OpenStack Designate DNS backend (unbound)
#
# This image runs a plain unbound DNS resolver, used as a Designate pool
# backend. It contains no Designate Python code, so it does not use the
# multi-stage source-build pipeline that the other Designate images use.

ARG BASE_IMAGE=localhost/openstack/openstack-base:latest

FROM ${BASE_IMAGE}

LABEL summary="OpenStack Designate DNS backend (unbound)" \
      io.k8s.description="unbound DNS resolver used as a Designate pool backend, with the kolla interface"

COPY unbound/bindeps.txt /tmp/bindeps.txt
RUN pkgs=$(cat /tmp/bindeps.txt | grep -v '^#' | grep -v '^$' | tr '\n' ' ') && \
    if [ -n "${pkgs}" ]; then microdnf -y install ${pkgs} && microdnf clean all; fi && rm /tmp/bindeps.txt
